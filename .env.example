# GrowBro environment variables
# Copy this file to `.env.local` and fill in your values.

# Optional: Anthropic API key for the AI chatbot.
# When this is NOT set, GrowBro falls back to its built-in local
# business-solution engine so the app is fully functional as a demo.
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: AI model override (defaults to claude-sonnet-5 family if unset)
# ANTHROPIC_MODEL=claude-sonnet-5
